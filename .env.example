# Copy to .env.local and fill in. Never commit the filled-in file.

# Google Gemini — used by the PS1 vision screener (app/api/analyze/route.js).
# Server-only; never reaches the browser.
GEMINI_API_KEY=

# Supabase — auth and storage.
# These two are public by design: row-level security protects the data, not
# secrecy of the anon key. Both must be prefixed NEXT_PUBLIC_ so the browser
# client can read them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional: PS4 error-pattern analyser -----------------------------------
# All have working defaults; uncomment only to override.

# Set to "off" to disable the neural correction layer. The analyser still runs
# on its lexicon and phonology layers and reports that the layer was skipped.
# NLP_GEC=on

# Correction checkpoint. The default was chosen over grammar-synthesis-small
# because the smaller model hallucinates — see docs/NLP_ARCHITECTURE.md.
# NLP_GEC_MODEL=Xenova/t5-base-grammar-correction

# Task prefix the checkpoint was trained with. Set to an empty value for
# grammar-synthesis checkpoints, which expect none.
# NLP_GEC_PREFIX=grammar:

# ONNX quantisation: q8 (default), fp16, q4, or full precision.
# NLP_GEC_DTYPE=q8
