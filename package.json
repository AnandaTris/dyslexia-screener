{
  "name": "dyslexia-writing-screener",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:rag": "cd rag-service && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000",
    "dev:all": "concurrently -k -n web,rag -c cyan,magenta \"npm:dev\" \"npm:dev:rag\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "warm:nlp": "node scripts/warm-nlp.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@google/genai": "^1.9.0",
    "@huggingface/transformers": "^4.2.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "dictionary-en": "^4.0.0",
    "double-metaphone": "^2.0.1",
    "next": "^14.2.15",
    "nspell": "^2.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "vitest": "^2.1.9"
  }
}
