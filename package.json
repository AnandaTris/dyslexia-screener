{
  "name": "dyslexia-writing-screener",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:rag": "cd rag-service && node ../scripts/venv-python.mjs -m uvicorn app.main:app --reload --port 8000",
    "dev:all": "concurrently -k -n web,rag -c cyan,magenta \"npm:dev\" \"npm:dev:rag\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "warm:nlp": "node scripts/warm-nlp.mjs",
    "test": "vitest run --exclude \"**/e2e-*.test.js\"",
    "test:watch": "vitest --exclude \"**/e2e-*.test.js\"",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run e2e-students.test.js e2e-student-access.test.js e2e-live.test.js",
    "test:all": "vitest run",
    "fuzz": "node scripts/run-fuzz.mjs",
    "fuzz:smoke": "node scripts/run-fuzz.mjs --runs 500",
    "fuzz:24h": "node scripts/run-fuzz.mjs --duration 24h"
  },
  "dependencies": {
    "@google/genai": "^1.9.0",
    "@huggingface/transformers": "^4.2.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "dictionary-en": "^4.0.0",
    "double-metaphone": "^2.0.1",
    "next": "^15.5.23",
    "nspell": "^2.1.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "fast-check": "^4.9.0",
    "vitest": "^2.1.9"
  }
}
